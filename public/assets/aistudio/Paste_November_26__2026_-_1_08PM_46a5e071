        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `VortexTitan6_Patch_${Date.now()}.json`;
        a.click();
        URL.revokeObjectURL(url);
        showToast("💾 PATCH SAVED AS JSON!");
