<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>VORTEX TITAN 6.0 — Flagship Synthesizer, 3D–5D Pad & Sounds ID Workstation</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-chassis: #0b0d12;
      --bg-panel: #131722;
      --bg-card: #1a1f2e;
      --accent-cyan: #00f0ff;
      --accent-amber: #ff9d00;
      --accent-acid: #39ff14;
      --accent-magenta: #ff2a85;
      --border-subtle: rgba(255, 255, 255, 0.08);
    }

    body.skin-acid {
      --bg-chassis: #070d08;
      --accent-cyan: #39ff14;
      --accent-amber: #facc15;
      --accent-magenta: #a3e635;
    }
    body.skin-crimson {
      --bg-chassis: #11080b;
      --accent-cyan: #ff2a55;
      --accent-amber: #ff8c00;
      --accent-magenta: #f43f5e;
    }
    body.skin-titanium {
      --bg-chassis: #0e1015;
      --accent-cyan: #e2e8f0;
      --accent-amber: #38bdf8;
      --accent-magenta: #94a3b8;
    }

    * {
      box-sizing: border-box;
      user-select: none;
      -webkit-user-select: none;
    }

    body {
      font-family: 'Inter', sans-serif;
      background-color: var(--bg-chassis);
      color: #e2e8f0;
      overflow-x: hidden;
      transition: background-color 0.25s ease;
    }

    .font-mono-tech {
      font-family: 'JetBrains Mono', monospace;
    }

    .synth-chassis {
      background: radial-gradient(circle at 50% 0%, #1d2436 0%, #0b0d12 75%);
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.85), inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }

    .module-panel {
      background: linear-gradient(180deg, #171c29 0%, #111520 100%);
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05), 0 4px 12px rgba(0, 0, 0, 0.4);
    }

    .knob-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      cursor: ns-resize;
    }

    .knob-dial {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      background: conic-gradient(from 220deg, #1e2536 0%, #0e121b 100%);
      border: 2px solid #2c354d;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.6), inset 0 2px 3px rgba(255, 255, 255, 0.1);
      position: relative;
      transition: border-color 0.15s ease;
    }

    .knob-dial:hover {
      border-color: var(--accent-cyan);
    }

    .knob-indicator {
      position: absolute;
      top: 4px;
      left: 50%;
      width: 3px;
      height: 11px;
      background: var(--accent-cyan);
      border-radius: 2px;
      transform-origin: 50% 15px;
      box-shadow: 0 0 8px var(--accent-cyan);
    }

    .knob-acid .knob-indicator {
      background: var(--accent-acid);
      box-shadow: 0 0 8px var(--accent-acid);
    }

    .knob-amber .knob-indicator {
      background: var(--accent-amber);
      box-shadow: 0 0 8px var(--accent-amber);
    }

    .knob-magenta .knob-indicator {
      background: var(--accent-magenta);
      box-shadow: 0 0 8px var(--accent-magenta);
    }

    input[type="range"].synth-slider {
      -webkit-appearance: none;
      appearance: none;
      background: #0d1017;
      height: 6px;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    input[type="range"].synth-slider::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: var(--accent-cyan);
      cursor: pointer;
      box-shadow: 0 0 10px var(--accent-cyan);
    }

    .piano-white {
      background: linear-gradient(180deg, #f8fafc 0%, #cbd5e1 100%);
      border: 1px solid #475569;
      border-radius: 0 0 6px 6px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.5);
      transition: transform 0.05s, background 0.05s;
    }

    .piano-white.active, .piano-white:active {
      background: linear-gradient(180deg, #bae6fd 0%, #38bdf8 100%);
      transform: translateY(2px);
    }

    .piano-black {
      background: linear-gradient(180deg, #1e293b 0%, #090d16 100%);
      border: 1px solid #000;
      border-radius: 0 0 4px 4px;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.8);
      z-index: 10;
      transition: transform 0.05s, background 0.05s;
    }

    .piano-black.active, .piano-black:active {
      background: linear-gradient(180deg, #0284c7 0%, #0369a1 100%);
      transform: translateY(2px);
    }

    .led-on {
      box-shadow: 0 0 10px currentColor;
    }

    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #0b0d12;
    }
    ::-webkit-scrollbar-thumb {
      background: #2b354b;
      border-radius: 3px;
    }
  </style>
</head>
<body class="min-h-screen p-2 sm:p-4 lg:p-6 flex flex-col items-center justify-center">

  <div class="synth-chassis w-full max-w-[1480px] rounded-2xl p-3 sm:p-5 flex flex-col gap-4">

    <!-- TOP MASTER HEADER & PRESET / TRANSPORT BAR -->
    <header class="module-panel rounded-xl p-3 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-cyan-400 via-blue-600 to-fuchsia-600 flex items-center justify-center shadow-lg shadow-cyan-500/20 shrink-0">
          <span class="font-extrabold text-slate-950 text-base">VT6</span>
        </div>
        <div>
          <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-base sm:text-lg font-extrabold tracking-wider text-white">VORTEX TITAN <span class="text-cyan-400">6.0</span></h1>
            <span class="px-2 py-0.5 text-[10px] font-mono-tech font-bold bg-cyan-500/15 text-cyan-300 border border-cyan-500/30 rounded-full">SUPERINTENDENT HYBRID</span>
            <button id="midiStatusBadge" class="px-2 py-0.5 text-[10px] font-mono-tech font-bold bg-slate-800 text-slate-400 border border-slate-700 rounded-full cursor-pointer" title="Click to scan Web MIDI / MPE devices">MIDI: SCANNING</button>
            <button id="soundsIdBadge" class="px-2 py-0.5 text-[10px] font-mono-tech font-bold bg-indigo-500/20 text-indigo-300 border border-indigo-500/40 rounded-full cursor-pointer" title="Open Sounds ID Acoustic & Patch Identifier">SOUNDS ID: READY</button>
            <button id="micInputBtn" class="px-2 py-0.5 text-[10px] font-mono-tech font-bold bg-emerald-500/15 text-emerald-300 border border-emerald-500/40 rounded-full cursor-pointer" title="Toggle Live Mic / External Audio Analysis for Sounds ID">MIC ID: OFF</button>
          </div>
          <p class="text-[11px] text-slate-400">Hybrid Morph • String Resonator • Kick Sidechain • 3D–5D XY&Z Pad • 128-Step 303 & 909 • Sounds ID</p>
        </div>
      </div>

      <!-- Preset Selector, Skin Theme & Patch JSON I/O -->
      <div class="flex flex-wrap items-center gap-1.5 bg-slate-950/70 p-1.5 rounded-xl border border-slate-800">
        <button id="prevPresetBtn" class="p-2 rounded-lg bg-slate-800/80 hover:bg-slate-700 text-slate-300 text-xs font-bold" title="Previous Preset">◀</button>
        <select id="presetSelect" class="bg-slate-900 text-cyan-300 font-mono-tech text-xs font-semibold px-2.5 py-1.5 rounded-lg border border-slate-700 focus:outline-none focus:border-cyan-400 min-w-[190px]">
          <option value="cyber_acid">01. ACID REBIRTH 303 (Legato)</option>
          <option value="quantum_supersaw">02. HYPERION SUPERSAW LEAD</option>
          <option value="spectral_pad">03. NEBULA GRANULAR CLOUD</option>
          <option value="sub_reese">04. DARK MATTER FM REESE</option>
          <option value="psy_arp">05. GOA QUANTUM ARP 142</option>
          <option value="blade_brass">06. CYBERPUNK ANALOG BRASS</option>
        </select>
        <button id="nextPresetBtn" class="p-2 rounded-lg bg-slate-800/80 hover:bg-slate-700 text-slate-300 text-xs font-bold" title="Next Preset">▶</button>
        <button id="randomizePatchBtn" class="px-2.5 py-1.5 rounded-lg bg-gradient-to-r from-fuchsia-600 to-purple-600 hover:from-fuchsia-500 hover:to-purple-500 text-white text-xs font-bold flex items-center gap-1 shadow-md shadow-fuchsia-600/20 transition" title="Auto-Dice Patch Generator">
          <span>🎲</span> DICE
        </button>
        <button id="exportPatchBtn" class="px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-cyan-300 text-[11px] font-mono-tech font-bold" title="Save Patch as JSON">SAVE</button>
        <button id="importPatchBtn" class="px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-[11px] font-mono-tech font-bold" title="Load Patch JSON">LOAD</button>
        <input id="importPatchFile" type="file" accept=".json" class="hidden" />
        <select id="skinSelect" class="bg-slate-900 text-amber-300 font-mono-tech text-[11px] px-2 py-1.5 rounded-lg border border-slate-700" title="Custom Hardware Skin">
          <option value="default">SKIN: CYBER CYAN</option>
          <option value="acid">SKIN: ACID VOLT</option>
          <option value="crimson">SKIN: CRIMSON ANALOG</option>
          <option value="titanium">SKIN: TITANIUM</option>
        </select>
      </div>

      <!-- Master Transport, WAV Recorder, BPM & Master Volume -->
      <div class="flex flex-wrap items-center gap-2">
        <div class="flex items-center gap-1.5 bg-slate-950/80 px-2.5 py-1.5 rounded-xl border border-slate-800">
          <span class="text-[10px] font-bold text-slate-400 uppercase">BPM</span>
          <input id="bpmInput" type="number" min="60" max="220" value="136" class="w-11 bg-transparent text-amber-400 font-mono-tech font-bold text-sm text-center focus:outline-none" />
        </div>

        <button id="seqPlayBtn" class="px-3.5 py-2 rounded-xl bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-300 border border-emerald-500/40 font-bold text-xs flex items-center gap-1.5 transition">
          <span id="seqPlayIcon">▶</span> <span id="seqPlayLabel">PLAY</span>
        </button>

        <button id="wavRecBtn" class="px-3 py-2 rounded-xl bg-amber-500/15 hover:bg-amber-500/25 text-amber-300 border border-amber-500/40 font-bold text-xs flex items-center gap-1 transition" title="Record Stereo Audio">
          <span id="wavRecDot" class="w-2 h-2 rounded-full bg-amber-400"></span> <span id="wavRecLabel">REC AUDIO</span>
        </button>

        <button id="panicBtn" class="px-2.5 py-2 rounded-xl bg-rose-500/15 hover:bg-rose-500/25 text-rose-300 border border-rose-500/30 font-bold text-xs transition" title="All Notes Off">
          PANIC
        </button>

        <div class="flex items-center gap-1.5 bg-slate-950/80 px-2.5 py-1.5 rounded-xl border border-slate-800">
          <span class="text-[10px] font-bold text-cyan-400">VOL</span>
          <input id="masterVolSlider" type="range" min="0" max="1" step="0.01" value="0.78" class="synth-slider w-16" />
        </div>
      </div>
    </header>

    <!-- ROW 2: OSCILLOSCOPE / FFT + SOUNDS ID OVERLAY + MACROS + 3D–5D XY&Z MORPH PAD -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
      <div class="lg:col-span-5 module-panel rounded-xl p-3 flex flex-col justify-between gap-2">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-cyan-400 led-on"></span>
            <span class="text-xs font-bold tracking-wider uppercase text-slate-300">Quantum Oscilloscope & FFT</span>
          </div>
          <div class="flex items-center gap-1">
            <button id="scopeModeWave" class="px-2 py-0.5 text-[10px] font-mono-tech font-bold rounded bg-slate-800 text-slate-400">WAVE</button>
            <button id="scopeModeFFT" class="px-2 py-0.5 text-[10px] font-mono-tech font-bold rounded bg-slate-800 text-slate-400">FFT</button>
            <button id="scopeModeDual" class="px-2 py-0.5 text-[10px] font-mono-tech font-bold rounded bg-cyan-500/20 text-cyan-300 border border-cyan-500/40">HYBRID</button>
          </div>
        </div>
        <div class="relative w-full h-28 bg-slate-950 rounded-lg border border-slate-800/90 overflow-hidden">
          <canvas id="visualizerCanvas" class="w-full h-full block"></canvas>
          <div id="soundsIdOverlay" class="hidden absolute top-2 right-2 bg-slate-950/90 border border-indigo-500/40 rounded-lg px-2.5 py-1.5 text-[10px] font-mono-tech text-indigo-200 shadow-lg max-w-[240px]">
            <div class="flex items-center justify-between gap-2 font-extrabold text-indigo-300">
              <span>SOUNDS ID</span>
              <span id="soundsIdConfidence" class="text-emerald-400">94%</span>
            </div>
            <div id="soundsIdMatchName" class="text-white font-bold truncate mt-0.5">ACID REBIRTH 303</div>
            <div id="soundsIdMeta" class="text-slate-400 text-[9px] truncate">130.8 Hz (C3) • 303 Acid Resonant</div>
          </div>
          <div id="audioInitOverlay" class="absolute inset-0 bg-slate-950/85 backdrop-blur-sm flex items-center justify-center cursor-pointer">
            <span class="px-4 py-1.5 rounded-full bg-cyan-500 text-slate-950 font-extrabold text-xs tracking-wide shadow-lg shadow-cyan-500/40 animate-pulse">
              ⚡ CLICK ANY KEY OR HERE TO IGNITE AUDIO ENGINE
            </span>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7 module-panel rounded-xl p-3 flex flex-col justify-between">
        <div class="flex items-center justify-between mb-2">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-amber-400 led-on"></span>
            <span class="text-xs font-bold tracking-wider uppercase text-slate-300">Performance Macros & Superintendent Hybrid</span>
          </div>
          <span id="statusToast" class="text-[11px] font-mono-tech text-cyan-300">READY • QUANTUM DSP ONLINE</span>
        </div>
        <div class="grid grid-cols-3 sm:grid-cols-6 gap-2 pt-1">
          <div class="knob-container knob-amber bg-slate-950/60 p-2 rounded-xl border border-slate-800/80" data-param="macroAcid" data-min="0" data-max="1" data-val="0.55">
            <div class="knob-dial"><div class="knob-indicator"></div></div>
            <span class="text-[10px] font-bold text-amber-300 mt-1">ACID SCREAM</span>
            <span class="knob-val text-[10px] font-mono-tech text-slate-400">55%</span>
          </div>
          <div class="knob-container bg-slate-950/60 p-2 rounded-xl border border-slate-800/80" data-param="macroSpace" data-min="0" data-max="1" data-val="0.40">
            <div class="knob-dial"><div class="knob-indicator"></div></div>
            <span class="text-[10px] font-bold text-cyan-300 mt-1">Q4NTUM SPACE</span>
            <span class="knob-val text-[10px] font-mono-tech text-slate-400">40%</span>
          </div>
          <div class="knob-container knob-magenta bg-slate-950/60 p-2 rounded-xl border border-slate-800/80" data-param="macroGrit" data-min="0" data-max="1" data-val="0.30">
            <div class="knob-dial"><div class="knob-indicator"></div></div>
            <span class="text-[10px] font-bold text-fuchsia-300 mt-1">PEDAL CRUSH</span>
            <span class="knob-val text-[10px] font-mono-tech text-slate-400">30%</span>
          </div>
          <div class="knob-container knob-acid bg-slate-950/60 p-2 rounded-xl border border-slate-800/80" data-param="hybridMorph" data-min="0" data-max="1" data-val="0.45">
            <div class="knob-dial"><div class="knob-indicator"></div></div>
            <span class="text-[10px] font-bold text-emerald-300 mt-1">HYBRID MORPH</span>
            <span class="knob-val text-[10px] font-mono-tech text-slate-400">45%</span>
          </div>
          <div class="knob-container bg-slate-950/60 p-2 rounded-xl border border-slate-800/80" data-param="resonatorMix" data-min="0" data-max="1" data-val="0.25">
            <div class="knob-dial"><div class="knob-indicator"></div></div>
            <span class="text-[10px] font-bold text-sky-300 mt-1">RESONATOR</span>
            <span class="knob-val text-[10px] font-mono-tech text-slate-400">25%</span>
          </div>
          <div class="knob-container knob-amber bg-slate-950/60 p-2 rounded-xl border border-slate-800/80" data-param="sidechainDepth" data-min="0" data-max="1" data-val="0.40">
            <div class="knob-dial"><div class="knob-indicator"></div></div>
            <span class="text-[10px] font-bold text-amber-300 mt-1">SIDECHAIN DUCK</span>
            <span class="knob-val text-[10px] font-mono-tech text-slate-400">40%</span>
          </div>
        </div>

        <!-- Superintendent 3D–5D XY&Z Chaos Morph Pad -->
        <div class="mt-2.5 bg-slate-950/85 p-2.5 rounded-xl border border-slate-800 flex flex-col sm:flex-row items-center gap-3">
          <div id="xyMorphPad" class="relative w-full sm:w-52 h-20 rounded-lg bg-gradient-to-tr from-slate-900 via-slate-900 to-cyan-950/50 border border-cyan-500/30 cursor-crosshair overflow-hidden shrink-0">
            <div class="absolute inset-0 pointer-events-none opacity-25" style="background-image: linear-gradient(to right, rgba(0,240,255,0.25) 1px, transparent 1px), linear-gradient(to bottom, rgba(0,240,255,0.25) 1px, transparent 1px); background-size: 26px 20px;"></div>
            <div id="xyPuck" class="w-4 h-4 -ml-2 -mt-2 rounded-full bg-cyan-400 border-2 border-white shadow-[0_0_12px_#00f0ff] absolute top-1/2 left-1/2 pointer-events-none transition-transform duration-75"></div>
          </div>
          <div class="flex sm:flex-col justify-between sm:justify-center items-center sm:items-stretch gap-1 w-full sm:w-24 bg-slate-900/80 px-2 py-1.5 rounded-lg border border-slate-800 shrink-0">
            <div class="flex items-center justify-between text-[9px] font-mono-tech font-bold text-amber-300">
              <span>Z-AXIS</span>
              <span id="zAxisVal">50%</span>
            </div>
            <input id="zAxisSlider" type="range" min="0" max="1" step="0.01" value="0.5" class="synth-slider w-20 sm:w-full" title="Z-Axis Depth: Hybrid Morph & Resonator" />
            <div class="flex items-center justify-between text-[9px] font-mono-tech font-bold text-fuchsia-300">
              <span>4D/5D</span>
              <span id="hyperAxisVal">50%</span>
            </div>
            <input id="hyperAxisSlider" type="range" min="0" max="1" step="0.01" value="0.5" class="synth-slider w-20 sm:w-full" title="4D/5D Hyper-Dimension: Sidechain & FM/Grit" />
          </div>
          <div class="flex-1 flex flex-col justify-between gap-1 text-[10px] font-mono-tech w-full">
            <div class="flex items-center justify-between gap-1.5">
              <span class="font-extrabold text-cyan-300 uppercase">3D–5D XY&Z MORPH PAD</span>
              <div class="flex items-center gap-1">
                <button id="dimModeBtn" class="px-1.5 py-0.5 rounded bg-fuchsia-500/20 text-fuchsia-300 border border-fuchsia-500/40 font-bold" title="Cycle 3D / 4D / 5D Dimension Coupling">DIM: 5D</button>
                <button id="xySpringBtn" class="px-1.5 py-0.5 rounded bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 font-bold">MODE: SPRING</button>
              </div>
            </div>
            <span class="text-slate-400">X: <strong class="text-emerald-300">Cutoff</strong> • Y: <strong class="text-fuchsia-300">Res/Space</strong> • Z: <strong class="text-amber-300">Morph/Reso</strong> • 4D/5D: <strong class="text-cyan-300">SC/FM</strong></span>
            <span id="xyReadout" class="text-cyan-400">[5D] X:50% Y:50% Z:50% 4D/5D:50%</span>
          </div>
        </div>
      </div>
    </div>

    <!-- ROW 3: OSCILLATORS + T-BEE 303 FILTER + ENVELOPES & LFO -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
      <div class="lg:col-span-5 module-panel rounded-xl p-3.5 flex flex-col gap-2.5">
        <div class="flex items-center justify-between border-b border-slate-800 pb-2">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-cyan-400 led-on"></span>
            <h2 class="text-xs font-extrabold uppercase tracking-wider text-white">Multi-Engine Oscillator Bank</h2>
          </div>
          <div class="flex items-center gap-1.5">
            <button id="voiceModeBtn" class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 font-mono-tech text-[10px] font-bold">MODE: MONO LEGATO</button>
            <button id="granularToggleBtn" class="px-2 py-0.5 rounded bg-fuchsia-500/20 text-fuchsia-300 border border-fuchsia-500/40 font-mono-tech text-[10px] font-bold">GRANULAR: OFF</button>
          </div>
        </div>

        <div class="bg-slate-950/75 rounded-xl p-2.5 border border-slate-800/90 flex flex-col gap-2">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <button id="osc1Toggle" class="px-2 py-0.5 rounded bg-cyan-500 text-slate-950 font-extrabold text-[10px]">OSC 1</button>
              <select id="osc1Wave" class="bg-slate-900 text-slate-200 text-xs font-mono-tech px-2 py-1 rounded border border-slate-700">
                <option value="tb_square">TB-303 Diode Square</option>
                <option value="hybrid_morph">Superintendent Hybrid Morph</option>
                <option value="sawtooth">Super Sawtooth</option>
                <option value="square">Hollow Square</option>
                <option value="triangle">Pure Triangle</option>
                <option value="spectral_harm">Spectral Harmonic</option>
              </select>
            </div>
