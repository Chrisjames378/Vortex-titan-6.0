    function initWebMIDI() {
      const badge = document.getElementById('midiStatusBadge');
      if (!badge) return;
      if (!navigator.requestMIDIAccess) {
        badge.textContent = 'MIDI: BROWSER N/A';
        return;
      }

      navigator.requestMIDIAccess().then((midiAccess) => {
        const updateDevices = () => {
          const inputs = Array.from(midiAccess.inputs.values());
          if (inputs.length > 0) {
            badge.textContent = `MIDI/MPE: ${inputs[0].name.slice(0, 14).toUpperCase()}`;
            badge.className = 'px-2 py-0.5 text-[10px] font-mono-tech font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 rounded-full cursor-pointer';
            inputs.forEach(input => {
              input.onmidimessage = (msg) => {
                const [status, data1, data2] = msg.data;
                const cmd = status & 0xf0;
                if (cmd === 0x90 && data2 > 0) {
                  synth.noteOn(data1, data2 / 127, data2 > 112, false);
                  highlightKeyUI(data1, true);
                } else if (cmd === 0x80 || (cmd === 0x90 && data2 === 0)) {
                  synth.noteOff(data1);
                  highlightKeyUI(data1, false);
                } else if (cmd === 0xE0) {
                  const bend = ((data2 << 7) | data1) - 8192;
                  synth.pitchBend = (bend / 8192) * 2;
                  document.getElementById('pitchWheel').value = synth.pitchBend;
                } else if (cmd === 0xB0 && data1 === 1) {
                  synth.modWheelVal = data2 / 127;
                  document.getElementById('modWheel').value = synth.modWheelVal;
                }
              };
            });
          } else {
            badge.textContent = 'MIDI: NO HARDWARE';
          }
        };
        updateDevices();
        midiAccess.onstatechange = updateDevices;
      }).catch(() => {
        badge.textContent = 'MIDI: BLOCKED';
      });
    }

    const heldKeys = new Set();
    let arpTimer = null;
    let arpIndex = 0;

    function buildPiano() {
      const container = document.getElementById('pianoContainer');
      if (!container) return;
      container.innerHTML = '';

      const startMidi = (synth.baseOctave + 1) * 12;
      const totalKeys = 29;
      const isBlackKey = (m) => [1, 3, 6, 8, 10].includes(m % 12);

      const whiteNotes = [];
      for (let i = 0; i < totalKeys; i++) {
        const midi = startMidi + i;
        if (!isBlackKey(midi)) whiteNotes.push(midi);
      }

      const whiteWidthPct = 100 / whiteNotes.length;

      whiteNotes.forEach((midi, idx) => {
        const key = document.createElement('div');
        key.dataset.midi = midi;
        key.className = 'piano-white absolute top-1.5 bottom-1.5 cursor-pointer flex flex-col justify-end items-center pb-1.5';
        key.style.left = `calc(${idx * whiteWidthPct}% + 2px)`;
        key.style.width = `calc(${whiteWidthPct}% - 4px)`;

        if (midi % 12 === 0) {
          const lbl = document.createElement('span');
          lbl.className = 'text-[9px] font-mono-tech font-bold text-slate-500 pointer-events-none';
          lbl.textContent = midiName(midi);
          key.appendChild(lbl);
        }

        const down = (e) => { e.preventDefault(); triggerKeyDown(midi); };
        const up = (e) => { e.preventDefault(); triggerKeyUp(midi); };

        key.addEventListener('mousedown', down);
        key.addEventListener('mouseup', up);
        key.addEventListener('mouseleave', () => { if (heldKeys.has(midi)) triggerKeyUp(midi); });
        key.addEventListener('touchstart', down, { passive: false });
        key.addEventListener('touchend', up, { passive: false });

        container.appendChild(key);
      });

      let whiteIndex = 0;
      for (let i = 0; i < totalKeys; i++) {
        const midi = startMidi + i;
        if (!isBlackKey(midi)) {
          whiteIndex++;
        } else {
          const key = document.createElement('div');
          key.dataset.midi = midi;
          key.className = 'piano-black absolute top-1.5 h-[58%] cursor-pointer';
          const blackW = whiteWidthPct * 0.62;
          key.style.left = `calc(${whiteIndex * whiteWidthPct - blackW / 2}%)`;
          key.style.width = `${blackW}%`;

          const down = (e) => { e.preventDefault(); e.stopPropagation(); triggerKeyDown(midi); };
          const up = (e) => { e.preventDefault(); e.stopPropagation(); triggerKeyUp(midi); };

          key.addEventListener('mousedown', down);
          key.addEventListener('mouseup', up);
          key.addEventListener('mouseleave', () => { if (heldKeys.has(midi)) triggerKeyUp(midi); });
          key.addEventListener('touchstart', down, { passive: false });
          key.addEventListener('touchend', up, { passive: false });

          container.appendChild(key);
        }
      }
    }

    function highlightKeyUI(midi, active) {
      const el = document.querySelector(`[data-midi="${midi}"]`);
      if (el) {
        if (active) el.classList.add('active');
        else el.classList.remove('active');
      }
    }

    function triggerKeyDown(midi) {
      if (heldKeys.has(midi)) return;
      heldKeys.add(midi);
      highlightKeyUI(midi, true);

      const arpSelect = document.getElementById('arpMode');
      const arpMode = arpSelect ? arpSelect.value : 'off';
      if (arpMode === 'off') {
        synth.noteOn(midi, 0.88, false, heldKeys.size > 1);
      } else if (!arpTimer) {
        startArpeggiator();
      }
    }

    function triggerKeyUp(midi) {
      heldKeys.delete(midi);
      highlightKeyUI(midi, false);

      const arpSelect = document.getElementById('arpMode');
      const arpMode = arpSelect ? arpSelect.value : 'off';
      if (arpMode === 'off') {
        synth.noteOff(midi);
      }
    }

    function startArpeggiator() {
      const stepArp = () => {
        if (heldKeys.size === 0) {
          clearInterval(arpTimer);
          arpTimer = null;
          return;
        }
        const notes = Array.from(heldKeys).sort((a, b) => a - b);
        const mode = document.getElementById('arpMode').value;
        let noteToPlay = notes[0];

        if (mode === 'up') {
          noteToPlay = notes[arpIndex % notes.length];
        } else if (mode === 'down') {
          noteToPlay = notes[notes.length - 1 - (arpIndex % notes.length)];
        } else if (mode === 'updown') {
          const seq = notes.length > 1 ? [...notes, ...notes.slice(1, -1).reverse()] : notes;
          noteToPlay = seq[arpIndex % seq.length];
        } else {
          noteToPlay = notes[Math.floor(Math.random() * notes.length)];
        }

        arpIndex++;
        synth.noteOn(noteToPlay, 0.85, arpIndex % 4 === 1, false);
        setTimeout(() => synth.noteOff(noteToPlay), 110);
      };

      stepArp();
      arpTimer = setInterval(stepArp, 135);
    }

    const KEYBOARD_MAP = {
      'a': 0, 'w': 1, 's': 2, 'e': 3, 'd': 4, 'f': 5, 't': 6,
      'g': 7, 'y': 8, 'h': 9, 'u': 10, 'j': 11, 'k': 12, 'o': 13, 'l': 14, 'p': 15
    };

    window.addEventListener('keydown', (e) => {
      if (e.repeat || e.target.tagName === 'INPUT' || e.target.tagName === 'SELECT') return;
      const key = e.key.toLowerCase();
      if (key === ' ') {
        e.preventDefault();
        toggleSequencer();
        return;
      }
      if (KEYBOARD_MAP[key] !== undefined) {
        const midi = (synth.baseOctave + 1) * 12 + KEYBOARD_MAP[key];
        triggerKeyDown(midi);
      }
    });

    window.addEventListener('keyup', (e) => {
      const key = e.key.toLowerCase();
      if (KEYBOARD_MAP[key] !== undefined) {
        const midi = (synth.baseOctave + 1) * 12 + KEYBOARD_MAP[key];
        triggerKeyUp(midi);
      }
    });

    let scopeMode = 'hybrid';

    function startVisualizerLoop() {
      const canvas = document.getElementById('visualizerCanvas');
      if (!canvas) return;
      const ctx2d = canvas.getContext('2d');
      const freqData = new Uint8Array(1024);
      const timeData = new Uint8Array(1024);
      let latestMatchedPresetKey = 'cyber_acid';
      const sidLog = [];

      function resizeCanvas() {
        const rect = canvas.getBoundingClientRect();
        canvas.width = Math.max(1, rect.width * window.devicePixelRatio);
        canvas.height = Math.max(1, rect.height * window.devicePixelRatio);
      }
      resizeCanvas();
      window.addEventListener('resize', resizeCanvas);

      function freqToNoteName(freq) {
        if (!freq || freq < 20 || freq > 4500) return '--';
        const midi = Math.round(12 * Math.log2(freq / 440) + 69);
        const names = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B'];
        const note = names[((midi % 12) + 12) % 12];
        const oct = Math.floor(midi / 12) - 1;
        return `${note}${oct}`;
      }

      function runSoundsIdAnalysis() {
        if (!synth.analyser || !synth.ctx) {
          return {
            freq: synth.lastFreq || 130.81,
            note: freqToNoteName(synth.lastFreq || 130.81),
            centroid: 1420,
            timbre: '303 Acid Resonant',
            presetKey: 'cyber_acid',
            presetName: PRESETS.cyber_acid.name,
            confidence: 88
          };
        }

        synth.analyser.getByteFrequencyData(freqData);
        synth.analyser.getByteTimeDomainData(timeData);

        const nyquist = synth.ctx.sampleRate / 2;
        const binHz = nyquist / freqData.length;

        let maxMag = 0;
        let peakBin = 1;
        let weightedSum = 0;
        let magSum = 0;

        for (let i = 1; i < freqData.length; i++) {
          const mag = freqData[i];
          const hz = i * binHz;
          if (mag > maxMag && hz >= 32 && hz <= 2200) {
            maxMag = mag;
            peakBin = i;
          }
          weightedSum += hz * mag;
          magSum += mag;
        }

        const detectedFreq = maxMag > 8 ? +(peakBin * binHz).toFixed(1) : +(synth.lastFreq || 130.81).toFixed(1);
        const centroid = magSum > 0 ? Math.round(weightedSum / magSum) : 950;

        let timbre = synth.micActive ? 'Live Acoustic / Mic' : 'Hybrid Harmonic';
        if (!synth.micActive) {
          if (synth.params.filterModel === 'tbee303' || synth.params.filterRes > 10) {
            timbre = '303 Acid Resonant';
          } else if (synth.params.osc1Unison >= 4 && synth.params.osc1Wave === 'sawtooth') {
            timbre = 'Hyper Unison Saw';
          } else if (synth.granularEnabled || synth.params.envAttack > 0.25) {
            timbre = 'Spectral Granular Pad';
          } else if (synth.params.osc2Fm > 180) {
            timbre = 'FM Metallic / Reese';
          }
        }

        let bestKey = 'cyber_acid';
        let bestScore = -Infinity;
        Object.entries(PRESETS).forEach(([key, preset]) => {
          const cutDiff = Math.abs((preset.filterCutoff || 800) - synth.params.filterCutoff) / 4000;
          const resDiff = Math.abs((preset.filterRes || 8) - synth.params.filterRes) / 20;
          const decDiff = Math.abs((preset.envDecay || 0.25) - synth.params.envDecay) / 2;
          const uniDiff = Math.abs((preset.osc1Unison || 2) - synth.params.osc1Unison) / 5;
          const score = 100 - (cutDiff * 35 + resDiff * 30 + decDiff * 20 + uniDiff * 15);
          if (score > bestScore) {
            bestScore = score;
            bestKey = key;
          }
        });

        const confidence = Math.max(62, Math.min(99, Math.round(bestScore)));
        const noteLabel = freqToNoteName(detectedFreq);
        latestMatchedPresetKey = bestKey;

        return {
          freq: detectedFreq,
          note: noteLabel,
          centroid,
          timbre,
          presetKey: bestKey,
          presetName: PRESETS[bestKey]?.name || bestKey,
          confidence
        };
      }

      function updateSoundsIdUI(info, recordHistory = false) {
        const overlay = document.getElementById('soundsIdOverlay');
        const confEl = document.getElementById('soundsIdConfidence');
        const matchEl = document.getElementById('soundsIdMatchName');
        const metaEl = document.getElementById('soundsIdMeta');
        const pitchEl = document.getElementById('sidPitchReadout');
        const centEl = document.getElementById('sidCentroidReadout');
        const timbreEl = document.getElementById('sidTimbreReadout');
        const bestEl = document.getElementById('sidBestMatchReadout');
        const countEl = document.getElementById('sidHistoryCount');
        const listEl = document.getElementById('soundsIdLogList');

        if (overlay) overlay.classList.remove('hidden');
        if (confEl) confEl.textContent = `${info.confidence}%`;
        if (matchEl) matchEl.textContent = info.presetName;
        if (metaEl) metaEl.textContent = `${info.freq} Hz (${info.note}) • ${info.timbre}`;
        if (pitchEl) pitchEl.textContent = `${info.freq} Hz (${info.note})`;
        if (centEl) centEl.textContent = `${info.centroid} Hz`;
        if (timbreEl) timbreEl.textContent = info.timbre;
        if (bestEl) bestEl.textContent = `${info.presetName} (${info.confidence}%)`;

        if (recordHistory) {
          sidLog.unshift({ ...info, time: new Date().toLocaleTimeString() });
          if (sidLog.length > 15) sidLog.pop();
          if (countEl) countEl.textContent = `${sidLog.length} SCANS`;
          if (listEl) {
            listEl.innerHTML = sidLog.map(item => `
              <div class="flex items-center justify-between bg-slate-900/90 px-2.5 py-1.5 rounded-lg border border-slate-800">
                <div class="truncate pr-2">
                  <span class="text-indigo-300 font-bold">${item.presetName}</span>
                  <span class="text-slate-400 ml-1.5">${item.freq}Hz (${item.note}) • ${item.timbre}</span>
                </div>
                <span class="text-emerald-400 font-bold shrink-0">${item.confidence}%</span>
              </div>
            `).join('');
          }
        }
      }

      const scanBtn = document.getElementById('scanSoundIdBtn');
      if (scanBtn) {
        scanBtn.addEventListener('click', () => {
          synth.initAudio();
          const res = runSoundsIdAnalysis();
          updateSoundsIdUI(res, true);
          showToast(`🔊 SOUNDS ID: ${res.presetName} (${res.confidence}%)`);
        });
      }

      const applyMatchBtn = document.getElementById('sidApplyMatchBtn');
      if (applyMatchBtn) {
        applyMatchBtn.addEventListener('click', () => {
          const presetSelect = document.getElementById('presetSelect');
          if (presetSelect && PRESETS[latestMatchedPresetKey]) {
            presetSelect.value = latestMatchedPresetKey;
            applyPreset(latestMatchedPresetKey);
          }
        });
      }

      const soundsIdBadge = document.getElementById('soundsIdBadge');
      if (soundsIdBadge) {
        soundsIdBadge.addEventListener('click', () => {
          const tabBtn = document.querySelector('.tab-btn[data-tab="soundsIdTab"]');
          if (tabBtn) tabBtn.click();
          const res = runSoundsIdAnalysis();
          updateSoundsIdUI(res, true);
        });
      }

      let lastSidSampleTime = 0;
      function tickSoundsIdIfEnabled(nowMs) {
        const autoToggle = document.getElementById('sidAutoTrackToggle');
        const enabled = autoToggle ? autoToggle.checked : true;
        if (enabled && synth.ctx && nowMs - lastSidSampleTime > 320) {
          lastSidSampleTime = nowMs;
          const res = runSoundsIdAnalysis();
          updateSoundsIdUI(res, false);
        }
      }

      function render(nowMs = performance.now()) {
        requestAnimationFrame(render);
        tickSoundsIdIfEnabled(nowMs);
        const w = canvas.width;
        const h = canvas.height;
        ctx2d.clearRect(0, 0, w, h);

        ctx2d.strokeStyle = 'rgba(0, 240, 255, 0.07)';
        ctx2d.lineWidth = 1;
        for (let gx = 0; gx < w; gx += 40) {
          ctx2d.beginPath(); ctx2d.moveTo(gx, 0); ctx2d.lineTo(gx, h); ctx2d.stroke();
        }
        for (let gy = 0; gy < h; gy += 28) {
          ctx2d.beginPath(); ctx2d.moveTo(0, gy); ctx2d.lineTo(w, gy); ctx2d.stroke();
        }

        if (!synth.analyser) {
          ctx2d.strokeStyle = 'rgba(0, 240, 255, 0.45)';
          ctx2d.lineWidth = 2;
          ctx2d.beginPath();
          for (let x = 0; x < w; x += 4) {
            const y = h / 2 + Math.sin(x * 0.04 + nowMs * 0.005) * (h * 0.16);
            if (x === 0) ctx2d.moveTo(x, y);
            else ctx2d.lineTo(x, y);
          }
          ctx2d.stroke();
          return;
        }

        synth.analyser.getByteFrequencyData(freqData);
        synth.analyser.getByteTimeDomainData(timeData);

        if (scopeMode === 'fft' || scopeMode === 'hybrid') {
          const barCount = 96;
          const barW = w / barCount;
          for (let i = 0; i < barCount; i++) {
            const v = freqData[i * 2] / 255;
            const barH = v * h * 0.85;
            const grad = ctx2d.createLinearGradient(0, h, 0, h - barH);
            grad.addColorStop(0, 'rgba(0, 240, 255, 0.15)');
            grad.addColorStop(0.7, 'rgba(0, 240, 255, 0.55)');
            grad.addColorStop(1, 'rgba(255, 42, 133, 0.85)');
            ctx2d.fillStyle = grad;
            ctx2d.fillRect(i * barW + 1, h - barH, Math.max(1, barW - 2), barH);
          }
        }

        if (scopeMode === 'wave' || scopeMode === 'hybrid') {
          ctx2d.strokeStyle = '#00f0ff';
          ctx2d.lineWidth = 2.2;
          ctx2d.shadowColor = '#00f0ff';
          ctx2d.shadowBlur = 8;
          ctx2d.beginPath();
          const sliceWidth = w / timeData.length;
          let x = 0;
          for (let i = 0; i < timeData.length; i++) {
            const v = (timeData[i] - 128) / 128;
            const y = h / 2 + v * (h * 0.42);
            if (i === 0) ctx2d.moveTo(x, y);
            else ctx2d.lineTo(x, y);
            x += sliceWidth;
          }
          ctx2d.stroke();
          ctx2d.shadowBlur = 0;
        }
      }

      render();
    }

    window.addEventListener('DOMContentLoaded', () => {
      buildPiano();
      renderSequencer();
      renderDrumGrid();
      renderModMatrix();
      syncAllKnobsFromParams();
      startVisualizerLoop();
      initWebMIDI();

      const overlay = document.getElementById('audioInitOverlay');
      if (overlay) {
        overlay.addEventListener('click', () => {
          synth.initAudio();
          synth.noteOn(48, 0.7, false, false);
          setTimeout(() => synth.noteOff(48), 240);
        });
      }

      const micBtn = document.getElementById('micInputBtn');
      if (micBtn) micBtn.addEventListener('click', () => synth.toggleMicInput());

      const xyPad = document.getElementById('xyMorphPad');
      const xyPuck = document.getElementById('xyPuck');
      const xyReadout = document.getElementById('xyReadout');
      const xySpringBtn = document.getElementById('xySpringBtn');
      const dimModeBtn = document.getElementById('dimModeBtn');
      const zAxisSlider = document.getElementById('zAxisSlider');
      const hyperAxisSlider = document.getElementById('hyperAxisSlider');
      const zAxisVal = document.getElementById('zAxisVal');
      const hyperAxisVal = document.getElementById('hyperAxisVal');

      let xySpringMode = true;
      let xyDragging = false;
      const dimModes = ['3D', '4D', '5D'];
      let dimIdx = 2;
      let curNormX = 0.5;
      let curNormY = 0.5;
      let curZ = 0.5;
      let curHyper = 0.5;

      function applyXYZHyperState() {
        const activeDim = dimModes[dimIdx];
        const invY = 1 - curNormY;
        const z = curZ;
        const hyper = curHyper;

        synth.params.filterCutoff = Math.round(120 + curNormX * 8380);
        synth.params.filterRes = +(1.5 + invY * 18.5).toFixed(1);
        synth.params.macroSpace = +invY.toFixed(2);
        synth.params.hybridMorph = +z.toFixed(2);
        synth.params.resonatorMix = +(z * 0.85).toFixed(2);

        if (activeDim === '4D' || activeDim === '5D') {
          synth.params.sidechainDepth = +hyper.toFixed(2);
        }
        if (activeDim === '5D') {
          synth.params.osc2Fm = Math.round(hyper * 420);
          synth.params.macroGrit = +(hyper * 0.75).toFixed(2);
        }

        if (xyPuck) {
          xyPuck.style.left = `${curNormX * 100}%`;
          xyPuck.style.top = `${curNormY * 100}%`;
          const scale = 0.7 + z * 0.85;
          xyPuck.style.transform = `scale(${scale.toFixed(2)})`;
        }
        if (zAxisSlider) zAxisSlider.value = z;
        if (hyperAxisSlider) hyperAxisSlider.value = hyper;
        if (zAxisVal) zAxisVal.textContent = `${Math.round(z * 100)}%`;
        if (hyperAxisVal) hyperAxisVal.textContent = `${Math.round(hyper * 100)}%`;

        syncAllKnobsFromParams();
        synth.updateLiveEffects();

        if (xyReadout) {
          xyReadout.textContent = `[${activeDim}] X:${Math.round(curNormX * 100)}% Y:${Math.round(invY * 100)}% Z:${Math.round(z * 100)}% 4D/5D:${Math.round(hyper * 100)}%`;
        }
      }

      function setXYPosition(normX, normY, zOverride = null) {
        curNormX = Math.max(0, Math.min(1, normX));
        curNormY = Math.max(0, Math.min(1, normY));
        if (zOverride !== null) curZ = Math.max(0, Math.min(1, zOverride));
        applyXYZHyperState();
      }

      if (xyPad) {
        const updateFromEvent = (clientX, clientY) => {
          const rect = xyPad.getBoundingClientRect();
          setXYPosition((clientX - rect.left) / rect.width, (clientY - rect.top) / rect.height);
        };
        xyPad.addEventListener('mousedown', (e) => {
          synth.initAudio();
          xyDragging = true;
          updateFromEvent(e.clientX, e.clientY);
        });
        xyPad.addEventListener('wheel', (e) => {
          e.preventDefault();
          synth.initAudio();
          const delta = e.deltaY < 0 ? 0.06 : -0.06;
          setXYPosition(curNormX, curNormY, curZ + delta);
        }, { passive: false });
        window.addEventListener('mousemove', (e) => {
          if (xyDragging) updateFromEvent(e.clientX, e.clientY);
        });
        window.addEventListener('mouseup', () => {
          if (!xyDragging) return;
          xyDragging = false;
          if (xySpringMode) setXYPosition(0.5, 0.5, 0.5);
        });
        xyPad.addEventListener('touchstart', (e) => {
          synth.initAudio();
          xyDragging = true;
          const t = e.touches[0];
          updateFromEvent(t.clientX, t.clientY);
        }, { passive: true });
        xyPad.addEventListener('touchmove', (e) => {
          if (!xyDragging) return;
          e.preventDefault();
          const t = e.touches[0];
          updateFromEvent(t.clientX, t.clientY);
        }, { passive: false });
        xyPad.addEventListener('touchend', () => {
          xyDragging = false;
          if (xySpringMode) setXYPosition(0.5, 0.5, 0.5);
        });
      }

      if (zAxisSlider) {
        zAxisSlider.addEventListener('input', (e) => {
          curZ = parseFloat(e.target.value);
          applyXYZHyperState();
        });
      }
      if (hyperAxisSlider) {
        hyperAxisSlider.addEventListener('input', (e) => {
          curHyper = parseFloat(e.target.value);
          applyXYZHyperState();
        });
      }
      if (dimModeBtn) {
        dimModeBtn.addEventListener('click', () => {
          dimIdx = (dimIdx + 1) % dimModes.length;
          dimModeBtn.textContent = `DIM: ${dimModes[dimIdx]}`;
          applyXYZHyperState();
          showToast(`PAD DIMENSIONALITY SET TO ${dimModes[dimIdx]}`);
        });
