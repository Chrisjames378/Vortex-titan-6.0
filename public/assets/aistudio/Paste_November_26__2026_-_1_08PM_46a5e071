      document.getElementById('midiStatusBadge').addEventListener('click', initWebMIDI);

      document.getElementById('skinSelect').addEventListener('change', (e) => {
        document.body.className = 'min-h-screen p-2 sm:p-4 lg:p-6 flex flex-col items-center justify-center';
        if (e.target.value !== 'default') {
          document.body.classList.add(`skin-${e.target.value}`);
