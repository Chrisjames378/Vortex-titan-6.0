      document.getElementById('genDrumGrooveBtn').addEventListener('click', () => {
        drumPatterns.kick = Array.from({ length: MAX_SEQ_STEPS }, (_, i) => (i % 4 === 0 || (i % 16 === 14 && Math.random() > 0.45)) ? 1 : 0);
        drumPatterns.snare = Array.from({ length: MAX_SEQ_STEPS }, (_, i) => (i % 8 === 4 || (i % 16 === 15 && Math.random() > 0.55)) ? 1 : 0);
        drumPatterns.hat = Array.from({ length: MAX_SEQ_STEPS }, (_, i) => (i % 2 === 1 || Math.random() > 0.65) ? 1 : 0);
        renderDrumGrid();
        showToast(`🥁 GENERATED ${activeSeqLength}-STEP TECHNO DRUM GROOVE`);
      });

      const presetSelect = document.getElementById('presetSelect');
      const presetKeys = Object.keys(PRESETS);

      presetSelect.addEventListener('change', (e) => applyPreset(e.target.value));

      document.getElementById('prevPresetBtn').addEventListener('click', () => {
        const idx = (presetKeys.indexOf(presetSelect.value) - 1 + presetKeys.length) % presetKeys.length;
        presetSelect.value = presetKeys[idx];
        applyPreset(presetKeys[idx]);
      });

      document.getElementById('nextPresetBtn').addEventListener('click', () => {
        const idx = (presetKeys.indexOf(presetSelect.value) + 1) % presetKeys.length;
        presetSelect.value = presetKeys[idx];
        applyPreset(presetKeys[idx]);
      });

      document.getElementById('randomizePatchBtn').addEventListener('click', () => {
        synth.initAudio();
        const waves = ['sawtooth', 'tb_square', 'hybrid_morph', 'square', 'triangle', 'spectral_harm'];
        const filters = ['tbee303', 'lowpass', 'bandpass', 'highpass'];
        const pedals = ['yellow_acid', 'fuzzy03', 'square_tube', 'metallicon'];

        synth.params.osc1Wave = waves[Math.floor(Math.random() * waves.length)];
        synth.params.osc2Wave = waves[Math.floor(Math.random() * waves.length)];
        synth.params.osc1Detune = Math.round(Math.random() * 42);
        synth.params.osc2Fm = Math.round(Math.random() * 350);
        synth.params.filterModel = filters[Math.floor(Math.random() * filters.length)];
        synth.params.filterCutoff = Math.round(180 + Math.random() * 4800);
        synth.params.filterRes = +(1 + Math.random() * 17).toFixed(1);
        synth.params.filterEnvAmt = Math.round(500 + Math.random() * 5500);
        synth.params.pedalModel = pedals[Math.floor(Math.random() * pedals.length)];
        synth.params.envDecay = +(0.08 + Math.random() * 0.9).toFixed(2);
        synth.params.delayMix = +(Math.random() * 0.5).toFixed(2);
        synth.params.reverbMix = +(Math.random() * 0.55).toFixed(2);

        document.getElementById('osc1Wave').value = synth.params.osc1Wave;
        document.getElementById('osc2Wave').value = synth.params.osc2Wave;
        document.getElementById('filterModel').value = synth.params.filterModel;
        document.getElementById('pedalModel').value = synth.params.pedalModel;

        syncAllKnobsFromParams();
        synth.updateLiveEffects();
        showToast("🎲 QUANTUM DICE GENERATED NEW PATCH!");
      });

      document.getElementById('seqPlayBtn').addEventListener('click', toggleSequencer);
      document.getElementById('panicBtn').addEventListener('click', () => {
        synth.panic();
        showToast("ALL NOTES OFF (PANIC)");
      });

      document.getElementById('masterVolSlider').addEventListener('input', (e) => {
        synth.params.masterVol = parseFloat(e.target.value);
        synth.updateLiveEffects();
      });

      document.getElementById('osc1Toggle').addEventListener('click', (e) => {
        synth.params.osc1Enabled = !synth.params.osc1Enabled;
        e.target.className = synth.params.osc1Enabled
          ? 'px-2 py-0.5 rounded bg-cyan-500 text-slate-950 font-extrabold text-[10px]'
          : 'px-2 py-0.5 rounded bg-slate-800 text-slate-500 font-extrabold text-[10px]';
      });

      document.getElementById('osc2Toggle').addEventListener('click', (e) => {
        synth.params.osc2Enabled = !synth.params.osc2Enabled;
        e.target.className = synth.params.osc2Enabled
          ? 'px-2 py-0.5 rounded bg-cyan-500 text-slate-950 font-extrabold text-[10px]'
          : 'px-2 py-0.5 rounded bg-slate-800 text-slate-500 font-extrabold text-[10px]';
      });

      document.getElementById('osc1Wave').addEventListener('change', (e) => synth.params.osc1Wave = e.target.value);
      document.getElementById('osc1Oct').addEventListener('change', (e) => synth.params.osc1Oct = parseInt(e.target.value));
      document.getElementById('osc2Wave').addEventListener('change', (e) => synth.params.osc2Wave = e.target.value);
      document.getElementById('osc2Semi').addEventListener('change', (e) => synth.params.osc2Semi = parseInt(e.target.value));
      document.getElementById('filterModel').addEventListener('change', (e) => synth.params.filterModel = e.target.value);
      document.getElementById('pedalModel').addEventListener('change', (e) => {
        synth.params.pedalModel = e.target.value;
        synth.updateDistortionCurve();
      });
      document.getElementById('lfoTarget').addEventListener('change', (e) => synth.params.lfoTarget = e.target.value);

      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.tab-btn').forEach(b => {
            b.className = 'tab-btn px-3 py-1.5 rounded-lg bg-slate-800/90 hover:bg-slate-700 text-slate-300 font-bold text-xs tracking-wide';
          });
          btn.className = 'tab-btn px-3 py-1.5 rounded-lg bg-cyan-500 text-slate-950 font-extrabold text-xs tracking-wide';

          document.querySelectorAll('.tab-content').forEach(tc => tc.classList.add('hidden'));
          document.getElementById(btn.dataset.tab).classList.remove('hidden');
        });
      });

      document.getElementById('genAcidPatternBtn').addEventListener('click', generateAcidRiff);
      document.getElementById('clearPatternBtn').addEventListener('click', () => {
        for (let i = 0; i < activeSeqLength; i++) {
          steps[i].active = false;
          steps[i].accent = false;
          steps[i].slide = false;
        }
        renderSequencer();
      });
      document.getElementById('swingSlider').addEventListener('input', (e) => {
        document.getElementById('swingVal').textContent = `${Math.round(parseFloat(e.target.value) * 100)}%`;
      });

      const scopeBtns = {
        scopeModeWave: 'wave',
        scopeModeFFT: 'fft',
        scopeModeDual: 'hybrid'
      };
      Object.entries(scopeBtns).forEach(([id, mode]) => {
        const el = document.getElementById(id);
        if (!el) return;
        el.addEventListener('click', () => {
          scopeMode = mode;
          Object.keys(scopeBtns).forEach(bid => {
            document.getElementById(bid).className = bid === id
              ? 'px-2 py-0.5 text-[10px] font-mono-tech font-bold rounded bg-cyan-500/20 text-cyan-300 border border-cyan-500/40'
              : 'px-2 py-0.5 text-[10px] font-mono-tech font-bold rounded bg-slate-800 text-slate-400';
          });
        });
      });

      const pitchWheel = document.getElementById('pitchWheel');
      pitchWheel.addEventListener('input', (e) => {
        synth.pitchBend = parseFloat(e.target.value);
      });
      pitchWheel.addEventListener('mouseup', () => {
        pitchWheel.value = 0;
        synth.pitchBend = 0;
      });
      pitchWheel.addEventListener('touchend', () => {
        pitchWheel.value = 0;
        synth.pitchBend = 0;
      });

      document.getElementById('modWheel').addEventListener('input', (e) => {
        synth.modWheelVal = parseFloat(e.target.value);
        synth.params.macroAcid = synth.modWheelVal;
        syncAllKnobsFromParams();
      });

      document.getElementById('octDownBtn').addEventListener('click', () => {
        synth.baseOctave = Math.max(1, synth.baseOctave - 1);
        document.getElementById('kbdOctaveLabel').textContent = `C${synth.baseOctave}`;
        buildPiano();
      });
      document.getElementById('octUpBtn').addEventListener('click', () => {
        synth.baseOctave = Math.min(5, synth.baseOctave + 1);
        document.getElementById('kbdOctaveLabel').textContent = `C${synth.baseOctave}`;
        buildPiano();
      });
    });
  </script>
</body>
</html>