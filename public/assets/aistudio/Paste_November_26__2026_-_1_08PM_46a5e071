    function exportPatternToMidi() {
      const tpq = 120;
      const stepTicks = 30;
      const events = [];

      let delta = 0;
      steps.slice(0, activeSeqLength).forEach((st) => {
        if (st.active) {
          const vel = st.accent ? 120 : 88;
          const gate = st.slide ? 34 : 20;
          events.push({ tick: delta, bytes: [0x90, st.note, vel] });
          events.push({ tick: delta + gate, bytes: [0x80, st.note, 0x00] });
        }
        delta += stepTicks;
      });

      events.sort((a, b) => a.tick - b.tick);

      const trackBytes = [];
      let lastTick = 0;
      events.forEach(ev => {
        const dt = ev.tick - lastTick;
        lastTick = ev.tick;
        if (dt < 128) {
          trackBytes.push(dt);
        } else {
          trackBytes.push(((dt >> 7) & 0x7f) | 0x80, dt & 0x7f);
        }
        trackBytes.push(...ev.bytes);
      });
      trackBytes.push(0x00, 0xFF, 0x2F, 0x00);

      const header = [
        0x4D, 0x54, 0x68, 0x64,
        0x00, 0x00, 0x00, 0x06,
        0x00, 0x00,
        0x00, 0x01,
        (tpq >> 8) & 0xFF, tpq & 0xFF
      ];

      const trkLen = trackBytes.length;
      const trkHeader = [
        0x4D, 0x54, 0x72, 0x6B,
        (trkLen >> 24) & 0xFF, (trkLen >> 16) & 0xFF, (trkLen >> 8) & 0xFF, trkLen & 0xFF
      ];

      const midiData = new Uint8Array([...header, ...trkHeader, ...trackBytes]);
      const blob = new Blob([midiData], { type: 'audio/midi' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `VortexTitan_Pattern_${['A','B','C','D'][currentPatternIdx]}.mid`;
      a.click();
      URL.revokeObjectURL(url);
      showToast(`💾 EXPORTED PATTERN ${['A','B','C','D'][currentPatternIdx]} AS .MID`);
    }

    let mediaRecorder = null;
